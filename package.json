{
  "name": "x-plan",
  "version": "0.1.0",
  "description": "Turn requirement documents into BDD (Gherkin) specs via PI agents",
  "type": "module",
  "bin": {
    "x-plan": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "eval": "tsx scripts/eval.ts"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.87.1",
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "commander": "^15.0.0",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.10",
    "mammoth": "^1.13.0",
    "typebox": "1.3.27",
    "unpdf": "^1.8.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "files": [
    "dist",
    "prompts"
  ]
}
