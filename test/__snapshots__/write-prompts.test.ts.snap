  - id: DEC-5
    effect: new
    conclusion: VIP 10 天內可取消
    answer: 回答 DEC-5
  - id: DEC-6
    effect: replace
    conclusion: 鑑賞期是到貨後 7 天
    answer: 回答 DEC-6
    supersedes:
      - TERM-1
openItems:
